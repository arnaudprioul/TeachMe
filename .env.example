# ── URLs ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5001
LANDING_URL=http://localhost:5000

# ── Database ──────────────────────────────────────────────────────────────────
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=teachme
DB_USER=teachme
DB_PASSWORD=teachme_secret

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:5379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_min_32_chars

# ── Mailer (Mailhog in dev) ────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=5025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@teachme.local

# ── SMS (Twilio — leave empty to use console mock in dev) ─────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
