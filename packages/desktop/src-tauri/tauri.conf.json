{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeachMe",
  "version": "0.1.0",
  "identifier": "dev.teachme.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5001",
    "beforeBuildCommand": "",
    "frontendDist": "../../webapp/.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "TeachMe",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
